---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import RecipeCard from '../components/RecipeCard.astro';
import PrepCard from '../components/PrepCard.astro';
import Signup from '../components/Signup.astro';
import { getRecipes, getPreps } from '../lib/content';
import { getPhoto } from '../lib/photos';
import { site } from '../lib/site';
import heroPhoto from '../assets/photos/mapo-tofu.jpg';

// Recipes with photos lead; the rest follow by date.
const recipes = (await getRecipes())
  .filter((r) => r.data.kind === 'recipe')
  .sort((a, b) => Number(!!getPhoto(b.data.photo)) - Number(!!getPhoto(a.data.photo)))
  .slice(0, 6);
const preps = await getPreps();
const [latest, ...olderPreps] = preps;
---

<Base image={heroPhoto.src}>
  <section class="hero wrap">
    <div class="hero-text">
      <p class="eyebrow">{site.tagline}</p>
      <h1 class="visually-hidden">{site.name}</h1>
      <Logo variant="full" class="hero-logo" />
      <p class="byline script">{site.byline}</p>
      <p class="lede">
        One Sunday of cooking, a week of real meals. These are the preps I actually make for my family: what was in the
        fridge, the order I cooked it in, and which container went where.
      </p>
      <div class="cta">
        <a class="btn" href={latest ? `/preps/${latest.id}/` : '/recipes/'}>This week's prep</a>
        <a class="text-link" href="/recipes/">All recipes</a>
      </div>
    </div>
    <figure class="hero-photo">
      <Image
        src={heroPhoto}
        alt="A bowl of tofu in a savory brown sauce with mushrooms and green onion, next to white rice, held in one hand"
        widths={[480, 800, 1100]}
        sizes="(min-width: 900px) 440px, 90vw"
        loading="eager"
        fetchpriority="high"
      />
      <svg class="badge" viewBox="0 0 120 120" aria-hidden="true">
        <defs><path id="hb" d="M60,60 m-45,0 a45,45 0 1,1 90,0 a45,45 0 1,1 -90,0" /></defs>
        <circle cx="60" cy="60" r="58" />
        <text><textPath href="#hb">COOKED ON SUNDAY · EATEN ALL WEEK ·</textPath></text>
        <text x="60" y="71" text-anchor="middle" class="b">B</text>
      </svg>
      <figcaption>From my kitchen</figcaption>
    </figure>
  </section>

  <section class="band">
    <div class="wrap band-inner">
      <p class="band-quote">
        Ideas can come from anywhere, <span class="script">even AI.</span> Nothing goes up here until I've cooked it,
        packed it, and reheated it midweek.
      </p>
      <a href="/about/#how" class="band-link">How recipes get here →</a>
    </div>
  </section>

  {
    latest && (
      <section class="wrap">
        <div class="head">
          <h2>Latest <span class="script">Sunday prep</span></h2>
          <a class="text-link" href="/preps/">All preps</a>
        </div>
        <PrepCard prep={latest} large />
        {olderPreps.length > 0 && (
          <div class="older">
            {olderPreps.slice(0, 2).map((p) => <PrepCard prep={p} />)}
          </div>
        )}
      </section>
    )
  }

  <section class="wrap">
    <div class="head">
      <h2>From the <span class="script">back of the fridge</span></h2>
      <a class="text-link" href="/recipes/">All recipes</a>
    </div>
    <div class="grid">
      {recipes.map((r) => <RecipeCard recipe={r} />)}
    </div>
  </section>

  <section class="wrap how" aria-labelledby="how-h">
    <h2 id="how-h" class="visually-hidden">How a Sunday prep works</h2>
    <ol>
      <li>
        <span class="n">i.</span>
        <h3>Start with the fridge</h3>
        <p>Every prep begins with what's already there, not a shopping trip.</p>
      </li>
      <li>
        <span class="n">ii.</span>
        <h3>Cook in parallel</h3>
        <p>Oven, stovetop and Instant Pot run at once, on a minute-by-minute plan.</p>
      </li>
      <li>
        <span class="n">iii.</span>
        <h3>Fridge or freezer</h3>
        <p>Each container gets a day and a place, so nothing gets lost at the back.</p>
      </li>
    </ol>
  </section>

  <section class="wrap" style="margin-top: 40px">
    <Signup />
  </section>
</Base>

<style>
  .hero {
    display: grid;
    gap: 40px;
    align-items: center;
    padding-top: clamp(36px, 7vw, 88px);
    padding-bottom: clamp(48px, 7vw, 88px);
  }
  @media (min-width: 900px) { .hero { grid-template-columns: 1.15fr 0.85fr; gap: 64px; } }
  .hero-text .eyebrow { margin-bottom: 22px; }
  .hero :global(.hero-logo) { font-size: clamp(3.6rem, 10vw, 7.2rem); }
  .byline { font-size: clamp(1.25rem, 2.4vw, 1.6rem); color: var(--pop); margin: 18px 0 22px; }
  .lede { font-size: 1.2rem; }
  .cta { display: flex; flex-wrap: wrap; gap: 24px; align-items: center; margin-top: 30px; }

  .hero-photo { margin: 0; position: relative; justify-self: center; width: 100%; max-width: 440px; }
  .hero-photo :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 220px 220px var(--radius) var(--radius); }
  .hero-photo figcaption { font-family: var(--ui); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-3); margin-top: 10px; text-align: right; }
  .badge { position: absolute; width: 112px; height: 112px; left: -28px; bottom: 36px; transform: rotate(-12deg); }
  .badge circle { fill: var(--pop); }
  .badge text { font-family: var(--ui); font-size: 9.5px; font-weight: 600; letter-spacing: 0.15em; fill: #fff8f0; }
  .badge .b { font-family: var(--display); font-style: italic; font-weight: 700; font-size: 34px; letter-spacing: 0; font-variation-settings: 'SOFT' 100, 'WONK' 1; }
  @media (max-width: 560px) { .badge { width: 88px; height: 88px; left: -6px; bottom: 28px; } }

  .band { background: var(--band); color: var(--band-ink); padding: clamp(40px, 6vw, 64px) 0; }
  .band-inner { display: grid; gap: 18px; justify-items: center; text-align: center; }
  .band-quote { font-family: var(--display); font-size: clamp(1.4rem, 3vw, 2rem); line-height: 1.3; max-width: 30em; margin: 0; font-variation-settings: 'SOFT' 100; }
  .band-quote .script { color: #f0a283; }
  .band-link { color: var(--band-ink); font-family: var(--ui); font-size: 0.88rem; font-weight: 600; letter-spacing: 0.04em; text-decoration: none; border-bottom: 1.5px solid #f0a283; padding-bottom: 2px; }

  .head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin-top: 88px; margin-bottom: 26px; flex-wrap: wrap; }
  .head h2 { margin: 0; font-size: clamp(1.8rem, 4vw, 2.6rem); }
  .head h2 .script { color: var(--pop); }
  .older { display: grid; gap: 16px; margin-top: 16px; }
  @media (min-width: 860px) { .older { grid-template-columns: 1fr 1fr; } }

  .how ol { list-style: none; padding: 40px 0 0; margin: 88px 0 0; display: grid; gap: 32px; border-top: 1px solid var(--line); }
  @media (min-width: 760px) { .how ol { grid-template-columns: repeat(3, 1fr); gap: 48px; } }
  .how h3 { margin: 4px 0 6px; font-size: 1.3rem; }
  .how p { margin: 0; color: var(--ink-2); font-size: 1rem; }
  .n { font-family: var(--display); font-style: italic; font-size: 1.6rem; color: var(--pop); font-variation-settings: 'SOFT' 100, 'WONK' 1; }
</style>
