---
import Base from '../layouts/Base.astro';
import RecipeCard from '../components/RecipeCard.astro';
import PrepCard from '../components/PrepCard.astro';
import Signup from '../components/Signup.astro';
import { getRecipes, getPreps } from '../lib/content';

const recipes = (await getRecipes()).filter((r) => r.data.kind === 'recipe').slice(0, 6);
const preps = await getPreps();
const [latest, ...olderPreps] = preps;
---

<Base>
  <section class="hero wrap">
    <p class="eyebrow">Weekly meal prep from what you already have</p>
    <h1>Cook once on Sunday.<br /><span>Eat well all week.</span></h1>
    <p class="lede">
      Real Sunday preps from a busy working-parent kitchen: what we had in the fridge, the order we cooked it in, and
      which container went where. Mixed cuisines, mostly vegetarian, never fussy.
    </p>
    <div class="cta">
      <a class="btn" href={latest ? `/preps/${latest.id}/` : '/recipes/'}>See this week's prep</a>
      <a class="text-link" href="/recipes/">Browse recipes →</a>
    </div>
  </section>

  <section class="wrap how" aria-label="How it works">
    <ol>
      <li><span class="n">1</span><div><h3>Start with the fridge</h3><p>Each prep begins with the groceries already on hand, not a shopping trip.</p></div></li>
      <li><span class="n">2</span><div><h3>Cook in parallel</h3><p>Oven, stovetop and Instant Pot run at once, on a minute-by-minute timeline.</p></div></li>
      <li><span class="n">3</span><div><h3>Fridge vs. freezer</h3><p>Every prep says which dabba goes where, and when to move it.</p></div></li>
    </ol>
  </section>

  {
    latest && (
      <section class="wrap">
        <div class="head">
          <h2>Latest Sunday prep</h2>
          <a href="/preps/">All preps →</a>
        </div>
        <PrepCard prep={latest} large />
        {olderPreps.length > 0 && (
          <div class="older">
            {olderPreps.slice(0, 2).map((p) => <PrepCard prep={p} />)}
          </div>
        )}
      </section>
    )
  }

  <section class="wrap">
    <div class="head">
      <h2>Recipes</h2>
      <a href="/recipes/">All recipes →</a>
    </div>
    <div class="grid">
      {recipes.map((r) => <RecipeCard recipe={r} />)}
    </div>
  </section>

  <section class="wrap" style="margin-top: 72px">
    <Signup />
  </section>
</Base>

<style>
  .hero { padding-top: clamp(40px, 8vw, 96px); padding-bottom: 32px; }
  .hero h1 { font-size: clamp(2.4rem, 7vw, 4.4rem); max-width: 14em; margin-bottom: 0.4em; }
  .hero h1 span { color: var(--basil); font-style: italic; font-weight: 500; }
  .cta { display: flex; flex-wrap: wrap; gap: 20px; align-items: center; margin-top: 28px; }
  .text-link { font-weight: 600; text-decoration: none; }

  .how ol {
    list-style: none;
    padding: 24px 0;
    margin: 24px 0 0;
    display: grid;
    gap: 24px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 760px) { .how ol { grid-template-columns: repeat(3, 1fr); } }
  .how li { display: flex; gap: 14px; }
  .how h3 { font-size: 1.1rem; margin: 2px 0 4px; }
  .how p { margin: 0; color: var(--ink-2); font-size: 0.95rem; }
  .n {
    flex: none;
    width: 32px; height: 32px;
    border-radius: 50%;
    display: grid; place-items: center;
    background: var(--turmeric-soft);
    color: var(--turmeric);
    font-family: var(--serif);
    font-weight: 700;
  }

  .head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin-top: 64px; margin-bottom: 18px; }
  .head h2 { margin: 0; }
  .head a { font-weight: 600; text-decoration: none; white-space: nowrap; }
  .older { display: grid; gap: 16px; margin-top: 16px; }
  @media (min-width: 820px) { .older { grid-template-columns: 1fr 1fr; } }
</style>
