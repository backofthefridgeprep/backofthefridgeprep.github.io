---
import type { Prep } from '../lib/content';
import { formatDate } from '../lib/content';

interface Props { prep: Prep; large?: boolean }
const { prep, large = false } = Astro.props;
const d = prep.data;
---

<a href={`/preps/${prep.id}/`} class:list={['prep', { large }]}>
  <div class="stat">
    <span class="num">{d.containers}</span>
    <span class="unit">meals</span>
  </div>
  <div class="body">
    <p class="eyebrow">Sunday prep · {formatDate(d.date)}{d.draft && ' · Draft'}</p>
    <h3>{d.title}</h3>
    <p class="desc">{d.description}</p>
    <p class="meta">{d.activeTime}{d.people && ` · ${d.people} people`} · {d.recipes.length} {d.recipes.length === 1 ? 'recipe' : 'recipes'}</p>
  </div>
</a>

<style>
  .prep {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 20px;
    padding: 22px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 0.15s ease;
  }
  .prep:hover { border-color: var(--basil); }
  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 84px;
    height: 84px;
    border-radius: 12px;
    background: var(--basil);
    color: var(--paper);
  }
  .num { font-family: var(--serif); font-size: 2.1rem; font-weight: 700; line-height: 1; }
  .unit { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; margin-top: 4px; }
  h3 { margin: 2px 0 6px; font-size: 1.35rem; }
  .desc { color: var(--ink-2); font-size: 0.95rem; margin: 0 0 8px; }
  .meta { color: var(--ink-3); font-size: 0.85rem; margin: 0; }
  .eyebrow { margin: 0; }
  .large h3 { font-size: clamp(1.5rem, 3vw, 2rem); }
  .large .stat { width: 104px; height: 104px; }
  .large .num { font-size: 2.7rem; }
  @media (max-width: 480px) {
    .prep { grid-template-columns: 1fr; }
    .stat { flex-direction: row; gap: 8px; width: auto; height: auto; padding: 8px 14px; justify-self: start; }
    .unit { margin-top: 0; }
    .large .stat { width: auto; height: auto; }
  }
</style>
