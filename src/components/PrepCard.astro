---
import type { Prep } from '../lib/content';
import { formatDate } from '../lib/content';

interface Props { prep: Prep; large?: boolean }
const { prep, large = false } = Astro.props;
const d = prep.data;
---

<a href={`/preps/${prep.id}/`} class:list={['prep', { large }]}>
  <div class="stat">
    <span class="num">{d.containers}</span>
    <span class="unit">meals</span>
  </div>
  <div class="body">
    <p class="eyebrow">Sunday prep · {formatDate(d.date)}{d.draft && ' · Draft'}</p>
    <h3>{d.title}</h3>
    <p class="desc">{d.description}</p>
    <p class="meta">{d.activeTime}{d.people && ` · ${d.people} people`} · {d.recipes.length} {d.recipes.length === 1 ? 'recipe' : 'recipes'}</p>
  </div>
  <span class="arrow" aria-hidden="true">→</span>
</a>

<style>
  .prep {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 24px;
    padding: 24px 26px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 0.15s ease;
  }
  .prep:hover { border-color: var(--pop); }
  .prep:hover h3 { color: var(--pop); }
  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 88px;
    height: 88px;
    border-radius: 50%;
    border: 1.5px solid var(--ink);
  }
  .num { font-family: var(--display); font-style: italic; font-size: 2.1rem; font-weight: 700; line-height: 1; font-variation-settings: 'SOFT' 100, 'WONK' 1; }
  .unit { font-family: var(--ui); font-size: 0.62rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.14em; margin-top: 3px; color: var(--ink-2); }
  h3 { margin: 4px 0 6px; font-size: 1.45rem; transition: color 0.15s; }
  .desc { color: var(--ink-2); font-size: 1rem; margin: 0 0 8px; line-height: 1.5; }
  .meta { font-family: var(--ui); color: var(--ink-3); font-size: 0.8rem; margin: 0; }
  .eyebrow { margin: 0; }
  .arrow { font-family: var(--ui); font-size: 1.4rem; color: var(--pop); }
  .large { padding: 32px; }
  .large h3 { font-size: clamp(1.6rem, 3vw, 2.2rem); }
  .large .stat { width: 112px; height: 112px; background: var(--pop); border-color: var(--pop); color: #fff8f0; }
  .large .stat .unit { color: #fff8f0; opacity: 0.85; }
  .large .num { font-size: 2.8rem; }
  @media (max-width: 560px) {
    .prep { grid-template-columns: 1fr; gap: 14px; padding: 22px; }
    .arrow { display: none; }
    .stat, .large .stat { width: 72px; height: 72px; }
    .large .num, .num { font-size: 1.8rem; }
  }
</style>
