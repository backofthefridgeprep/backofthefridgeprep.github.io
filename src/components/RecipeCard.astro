---
import { Image } from 'astro:assets';
import type { Recipe } from '../lib/content';
import { formatMinutes, totalMinutes } from '../lib/content';
import TestedStamp from './TestedStamp.astro';
import { getPhoto } from '../lib/photos';

interface Props { recipe: Recipe; index?: number }
const { recipe, index = 0 } = Astro.props;
const d = recipe.data;
const photo = getPhoto(d.photo);
const total = totalMinutes(recipe);
const time = formatMinutes(total);
const timeBucket = total === undefined ? '' : total <= 30 ? 'time:30' : total <= 60 ? 'time:60' : 'time:61';
const store = d.storage?.freezer ? 'store:freezer' : 'store:fridge';
const who = d.babyAge ? 'for:baby' : 'for:everyone';
// Recipe list filters: cuisine, total time, fridge vs freezer, who it's for.
const filters = [...d.cuisine.map((c) => `cuisine:${c.replace(/\s+/g, '_')}`), timeBucket, store, who].filter(Boolean).join(' ');
const kicker = d.babyAge ? `Baby food · ${d.babyAge}` : d.kind === 'technique' ? 'Technique' : d.course[0] ?? 'Recipe';
// Photo-less cards alternate between two warm tints.
const tint = index % 2 === 0 ? 'var(--saffron-soft)' : 'var(--pop-soft)';
---

<a href={`/recipes/${recipe.id}/`} class="card" data-filters={filters}>
  <div class="media">
    {
      photo ? (
        <Image src={photo} alt={d.imageAlt ?? ''} widths={[400, 700]} sizes="(min-width: 760px) 360px, 100vw" class="photo" />
      ) : (
        <div class="ph" style={`background:${tint}`} aria-hidden="true">
          <span class="ph-letter">{d.title[0]}</span>
          <span class="ph-note">photo coming</span>
        </div>
      )
    }
    {d.draft && <span class="chip pop draft">Draft</span>}
  </div>
  <div class="body">
    <p class="eyebrow">{kicker}{!d.babyAge && d.cuisine.length > 0 && ` · ${d.cuisine.join(' · ')}`}</p>
    <h3>{d.title}</h3>
    <div class="meta">
      {d.tested && <TestedStamp date={d.tested.date} by={d.tested.by} size="sm" />}
      {time && <span class="chip">{time}</span>}
    </div>
  </div>
</a>

<style>
  .card { display: flex; flex-direction: column; gap: 14px; color: var(--ink); text-decoration: none; }
  .media { position: relative; aspect-ratio: 4 / 3; border-radius: var(--radius); overflow: hidden; background: var(--paper-2); }
  .media :global(.photo) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .card:hover .media :global(.photo) { transform: scale(1.03); }
  .ph { width: 100%; height: 100%; display: grid; place-items: center; position: relative; }
  .ph-letter {
    font-family: var(--display);
    font-style: italic;
    font-weight: 600;
    font-size: 5.5rem;
    line-height: 1;
    color: var(--ink);
    opacity: 0.22;
    font-variation-settings: 'SOFT' 100, 'WONK' 1;
  }
  .ph-note { position: absolute; bottom: 10px; right: 12px; font-family: var(--ui); font-size: 0.66rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-3); }
  .draft { position: absolute; top: 10px; left: 10px; }
  .body { display: flex; flex-direction: column; gap: 6px; flex: 1; }
  .eyebrow { margin: 0; }
  h3 { margin: 0; font-size: 1.4rem; line-height: 1.15; transition: color 0.15s; flex: 1; }
  .card:hover h3 { color: var(--pop); }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 8px; margin-top: 4px; }
</style>
