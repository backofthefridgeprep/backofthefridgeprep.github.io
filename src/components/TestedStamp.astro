---
// The "cooked and tested" mark. Round, a little like a rubber stamp.
import { formatDate } from '../lib/content';

interface Props { date: Date; by?: string; times?: number; size?: 'sm' | 'lg' }
const { date, by = 'Shreya', times, size = 'lg' } = Astro.props;
const label = `Cooked and tested by ${by}, ${formatDate(date)}${times ? `, made ${times} times` : ''}`;
---

{
  size === 'lg' ? (
    <div class="stamp" role="img" aria-label={label} title={label}>
      <svg viewBox="0 0 120 120" aria-hidden="true">
        <defs>
          <path id="ring" d="M60,60 m-44,0 a44,44 0 1,1 88,0 a44,44 0 1,1 -88,0" />
        </defs>
        <circle cx="60" cy="60" r="57" fill="none" stroke="currentColor" stroke-width="1.5" />
        <circle cx="60" cy="60" r="33" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="2 3" />
        <text class="ring">
          <textPath href="#ring" startOffset="0">COOKED &amp; TESTED · IN MY KITCHEN ·</textPath>
        </text>
        <text x="60" y="58" text-anchor="middle" class="by">{by}</text>
        <text x="60" y="74" text-anchor="middle" class="date">{formatDate(date)}</text>
      </svg>
    </div>
  ) : (
    <span class="mini" title={label}>
      <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
        <circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="1.5" />
        <path d="M4.8 8.3l2.1 2.1 4.3-4.6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      Tested by {by}
    </span>
  )
}

<style>
  .stamp {
    width: 118px;
    height: 118px;
    color: var(--saffron);
    transform: rotate(-8deg);
    flex: none;
  }
  .stamp svg { width: 100%; height: 100%; overflow: visible; }
  .ring { font-family: var(--ui); font-size: 9.6px; font-weight: 600; letter-spacing: 0.16em; fill: currentColor; }
  .by { font-family: var(--display); font-style: italic; font-weight: 700; font-size: 17px; fill: currentColor; font-variation-settings: 'SOFT' 100, 'WONK' 1; }
  .date { font-family: var(--ui); font-size: 8.5px; font-weight: 600; letter-spacing: 0.08em; fill: currentColor; text-transform: uppercase; }

  .mini {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--ui);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--saffron);
  }
</style>
