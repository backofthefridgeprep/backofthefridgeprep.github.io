---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { site } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  image?: string; // absolute or root-relative URL for og:image (Pinterest uses it)
  jsonLd?: Record<string, unknown>;
}

const { title, description = site.tagline, image, jsonLd } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} — ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).toString() : undefined;
const path = Astro.url.pathname;
const nav = [
  { href: '/recipes/', label: 'Recipes' },
  { href: '/preps/', label: 'Sunday preps' },
  { href: '/about/', label: 'About' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#fffcf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1d1612" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={jsonLd ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,400..800,0..100,0..1;1,9..144,400..800,0..100,0..1&family=Instrument+Sans:wght@400..600&family=Newsreader:ital,opsz,wght@0,6..72,400..600;1,6..72,400..500&display=swap"
    />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="visually-hidden" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a href="/" class="brand" aria-label={`${site.name} home`}>
          <Logo variant="mark" />
          <span class="brand-name">{site.name}</span>
        </a>
        <nav aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap foot">
        <div class="foot-brand">
          <a href="/" aria-label={`${site.name} home`}><Logo variant="full" class="foot-logo" /></a>
          <p class="byline script">{site.byline}</p>
        </div>
        <div class="foot-cols">
          <div>
            <p class="eyebrow">Cook</p>
            <a href="/recipes/">Recipes</a>
            <a href="/preps/">Sunday preps</a>
          </div>
          <div>
            <p class="eyebrow">Say hi</p>
            <a href={site.pinterest} rel="me">Pinterest</a>
            <a href={`mailto:${site.email}`}>Email</a>
            <a href="/about/">About</a>
          </div>
        </div>
        <p class="fine">
          Every recipe here is cooked in my own kitchen before it goes up. Nutrition figures, where shown, are estimates
          from USDA FoodData Central, not lab values. Nothing here is medical advice; talk to your doctor or a dietitian
          about your own diet. Food-safety times follow USDA guidance where noted.
        </p>
        <p class="fine">© {new Date().getFullYear()} {site.name}</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(8px);
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px 20px;
    min-height: 68px;
    flex-wrap: wrap;
  }
  .brand { display: inline-flex; align-items: baseline; gap: 12px; text-decoration: none; }
  .brand-name {
    font-family: var(--ui);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  nav { display: flex; gap: 2px; flex-wrap: wrap; }
  nav a {
    font-family: var(--ui);
    color: var(--ink-2);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.86rem;
    letter-spacing: 0.03em;
    padding: 6px 12px;
    border-radius: 999px;
  }
  nav a:hover { color: var(--ink); background: var(--paper-2); }
  nav a[aria-current='page'] { color: var(--ink); box-shadow: inset 0 -2px 0 var(--pop); border-radius: 0; }
  @media (max-width: 560px) {
    .bar { padding-top: 12px; padding-bottom: 6px; }
    .brand-name { display: none; }
    nav { margin-right: -12px; }
    nav a { padding: 6px 9px; }
  }

  main { min-height: 60vh; }

  .site-footer {
    margin-top: 110px;
    background: var(--band);
    color: var(--band-ink);
    padding: 56px 0 36px;
  }
  .foot { display: grid; gap: 28px; }
  @media (min-width: 760px) { .foot { grid-template-columns: 1fr auto; align-items: start; } .fine { grid-column: 1 / -1; } }
  .foot a { color: var(--band-ink); }
  .foot-brand > a { text-decoration: none; }
  .foot-brand :global(.foot-logo) { font-size: 2.6rem; color: var(--band-ink); }
  .byline { margin: 12px 0 0; font-size: 1.15rem; opacity: 0.85; }
  .foot-cols { display: flex; gap: 56px; }
  .foot-cols div { display: grid; gap: 6px; align-content: start; }
  .foot-cols a { font-family: var(--ui); font-size: 0.9rem; text-decoration: none; opacity: 0.9; }
  .foot-cols a:hover { opacity: 1; text-decoration: underline; }
  .foot .eyebrow { color: var(--band-ink); opacity: 0.6; margin: 0 0 4px; }
  .fine { font-family: var(--ui); font-size: 0.76rem; line-height: 1.55; opacity: 0.65; max-width: 62em; margin: 0; }
</style>
